{
  "name": "selfhost-helper",
  "version": "0.40.1",
  "description": "Node.js Project Manager",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "cross-env NODE_ENV=development vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:dev": "vite build && cross-env NODE_ENV=development electron-builder --config.extraMetadata.appId=com.selfhosthelper.dev --config.directories.output=release-dev --config.productName=\"SelfHost Helper Dev\"",
    "build:prod": "vite build && cross-env NODE_ENV=production electron-builder",
    "publish:prod": "vite build && dotenv -e .env -- cross-env NODE_ENV=production electron-builder --publish always",
    "build:web": "vite build",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "com.selfhosthelper.app",
    "productName": "SelfHost Helper",
    "asar": true,
    "asarUnpack": [
      "**/job.node",
      "**/node_modules/cloudflared/bin/**/*",
      "**/node_modules/@vscode/ripgrep/bin/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/node_modules/*/{test,tests,example,examples}",
      "!**/node_modules/.bin",
      "!**/node_modules/**/README.md",
      "!electron/job/src",
      "!electron/job/build/obj",
      "!electron/job/binding.gyp",
      "!electron/job/package-lock.json",
      "!electron/job/node_modules",
      "!electron/job/build/Makefile",
      "!electron/job/build/*.target.mk",
      "!electron/job/build/*.vcxproj*",
      "!electron/job/build/*.sln",
      "!electron/job/build/binding.sln",
      "!electron/job/build/job.vcxproj"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "DevRoots-Studio",
      "repo": "SelfHost-Helper",
      "releaseType": "release",
      "vPrefixedTagName": true
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "resources/icon.png"
    }
  },
  "author": {
    "name": "@DevRoots/AboMeezO",
    "email": "abomeezo2@gmail.com"
  },
  "license": "ISC",
  "overrides": {
    "vite": "$vite"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "esbuild": "0.27.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "postcss": "8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "4.1.18",
    "vite": "7.3.0",
    "wait-on": "9.0.3"
  },
  "dependencies": {
    "@eleung/react-grid-layout": "^1.8.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@vscode/ripgrep": "^1.17.0",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.5.16",
    "auto-launch": "5.0.6",
    "chalk": "^5.6.2",
    "chokidar": "5.0.0",
    "class-variance-authority": "0.7.1",
    "cloudflared": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "^4.0.0",
    "framer-motion": "12.23.26",
    "jotai": "^2.16.1",
    "lucide-react": "0.562.0",
    "monaco-editor": "0.55.1",
    "node-addon-api": "^8.5.0",
    "pg-hstore": "^2.3.4",
    "pidusage": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.11.0",
    "react-toastify": "^11.0.5",
    "sequelize": "6.37.7",
    "simple-git": "^3.32.3",
    "sqlite3": "5.1.7",
    "st.db": "^7.2.10",
    "tailwind-merge": "3.4.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.1.3",
    "ws": "^8.19.0"
  }
}
